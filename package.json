{
  "name": "translation-helper",
  "displayName": "Translation Helper",
  "description": "Quickly convert selected text into translation keys and update English/Arabic locale files.",
  "version": "1.0.0",
  "publisher": "custom-translation-helper",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "translationHelper.translateSelection",
        "title": "Translation Helper: React {t(\"key\")}"
      },
      {
        "command": "translationHelper.translateSelectionRawKey",
        "title": "Translation Helper: Raw Key \"key\""
      },
      {
        "command": "translationHelper.wrapWithTranslationFunction",
        "title": "Translation Helper: Wrap with t()"
      },
      {
        "command": "translationHelper.translateEjsStringWithAI",
        "title": "Translation Helper: EJS Smart Tag <%= __('key')%>"
      },
      {
        "command": "translationHelper.translateEjsWithAI",
        "title": "Translation Helper: EJS Code __('key')"
      },
      {
        "command": "translationHelper.setApiKey",
        "title": "Translation Helper: Set OpenAI API Key"
      },
      {
        "command": "translationHelper.translateTernaryWithT",
        "title": "Translation Helper: Wrap Condition with t()"
      }
    ],
    "keybindings": [
      {
        "command": "translationHelper.translateSelection",
        "key": "ctrl+shift+x",
        "when": "editorTextFocus"
      },
      {
        "command": "translationHelper.translateSelectionRawKey",
        "key": "ctrl+shift+s",
        "when": "editorTextFocus"
      },
      {
        "command": "translationHelper.wrapWithTranslationFunction",
        "key": "ctrl+shift+a",
        "when": "editorTextFocus"
      },
      {
        "command": "translationHelper.translateEjsStringWithAI",
        "key": "ctrl+shift+w",
        "when": "editorTextFocus"
      },
      {
        "command": "translationHelper.translateEjsWithAI",
        "key": "ctrl+shift+q",
        "when": "editorTextFocus"
      },
      {
        "command": "translationHelper.translateTernaryWithT",
        "key": "ctrl+shift+z",
        "when": "editorTextFocus"
      }
    ]
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "openai": "^7.5.0"
  }
}